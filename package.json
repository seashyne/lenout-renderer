{
  "name": "@lenout/render",
  "version": "0.9.0",
  "description": "Lenout Renderer (night) — DPI-aware tile-based WebGPU renderer with vector, SVG, text, compositing, WebNN refinement, and browser fallbacks.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/renderer.js",
  "types": "./dist/renderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./dpi": {
      "types": "./dist/dpi.d.ts",
      "import": "./dist/dpi.js"
    },
    "./scene-graph": {
      "types": "./dist/sceneGraph.d.ts",
      "import": "./dist/sceneGraph.js"
    },
    "./stroke-session": {
      "types": "./dist/strokeSession.d.ts",
      "import": "./dist/strokeSession.js"
    },
    "./tile-manager": {
      "types": "./dist/tileManager.d.ts",
      "import": "./dist/tileManager.js"
    },
    "./tier1": "./dist/tier1/canvas2dRenderer.js",
    "./tier2": "./dist/tier2/webgl2Renderer.js",
    "./tier3": "./dist/tier3/webgpuRenderer.js",
    "./gpu-device": {
      "types": "./dist/gpuDevice.d.ts",
      "import": "./dist/gpuDevice.js"
    },
    "./depth-projection": {
      "types": "./dist/depthProjection.d.ts",
      "import": "./dist/depthProjection.js"
    },
    "./compositor": {
      "types": "./dist/compositor.d.ts",
      "import": "./dist/compositor.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./text-layout": {
      "types": "./dist/textLayout.d.ts",
      "import": "./dist/textLayout.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./vector-path": {
      "types": "./dist/vectorPath.d.ts",
      "import": "./dist/vectorPath.js"
    }
  },
  "files": [
    "dist/",
    "src/shaders/*.wgsl"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "npm run build && node benchmarks/tile-cache.mjs",
    "demo": "vite demo --open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seashyne/lenout-renderer.git"
  },
  "keywords": [
    "webgpu",
    "renderer",
    "2d",
    "tile-rendering",
    "webnn",
    "canvas",
    "lenout"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
