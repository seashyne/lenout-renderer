{
  "name": "@lenout/render",
  "version": "0.6.0",
  "description": "Lenout Renderer (night) — tile-based WebGPU renderer with asynchronous WebNN brush refinement and WebGL2/Canvas fallbacks.",
  "type": "module",
  "main": "./dist/renderer.js",
  "types": "./dist/renderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./scene-graph": {
      "types": "./dist/sceneGraph.d.ts",
      "import": "./dist/sceneGraph.js"
    },
    "./stroke-session": {
      "types": "./dist/strokeSession.d.ts",
      "import": "./dist/strokeSession.js"
    },
    "./tile-manager": {
      "types": "./dist/tileManager.d.ts",
      "import": "./dist/tileManager.js"
    },
    "./tier1": "./dist/tier1/canvas2dRenderer.js",
    "./tier2": "./dist/tier2/webgl2Renderer.js",
    "./tier3": "./dist/tier3/webgpuRenderer.js"
  },
  "files": ["dist/", "src/shaders/*.wgsl"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite demo --open"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seashyne/lenout-renderer.git"
  },
  "keywords": ["webgpu", "renderer", "2d", "tile-rendering", "webnn", "canvas", "lenout"],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
